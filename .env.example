# =============================================
# AI 日报自动化 - 配置文件
# 复制本文件为 .env 并填写你的 API 密钥
# =============================================

# Claude API（必填）
# 标准 Anthropic API Key 格式: sk-ant-api03-xxx
# 如使用代理服务，填写代理的 key
ANTHROPIC_API_KEY=你的Claude_API_Key

# 如果使用中转代理，填写代理地址（否则留空）
# 示例: https://api.proxy.com
ANTHROPIC_BASE_URL=

# Tavily 新闻搜索 API（必填）
# 免费申请: https://app.tavily.com
TAVILY_API_KEY=你的Tavily_API_Key

# Server酱 微信推送（推荐填写，用于推送通知）
# 免费申请: https://sct.ftqq.com
SERVER_CHAN_KEY=你的Server酱SendKey

# GitHub Pages 访问地址（填写后推送通知含链接）
# 示例: https://yourname.github.io/ai-daily-report
GITHUB_PAGES_URL=

# 本地 Git 仓库路径（自动推送到 GitHub 用）
# 通常就是当前项目路径，留空则不自动推送
GIT_REPO_PATH=C:\Users\jiawa\ai-daily-report
